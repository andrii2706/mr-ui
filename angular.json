{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "ui": {
      "projectType": "library",
      "root": "projects/ui",
      "sourceRoot": "projects/ui/src",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ui/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "gallery": {
      "projectType": "application",
      "root": "projects/gallery",
      "sourceRoot": "projects/gallery/src",
      "prefix": "app",
      "schematics": {
        "@schematics/angular:component": {
          "changeDetection": "OnPush",
          "style": "none"
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/gallery/src/main.ts",
            "tsConfig": "projects/gallery/tsconfig.app.json",
            "styles": [
              "projects/gallery/src/styles.css"
            ],
            "outputPath": "dist/gallery"
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "baseHref": "./"
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "gallery:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4400
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/gallery/tsconfig.spec.json",
            "include": [
              "../../ui/src/**/*.spec.ts",
              "**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}
