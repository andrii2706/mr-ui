{
  "name": "mr-ui",
  "version": "0.1.0",
  "private": true,
  "description": "@mr/ui (пакет @andrii2706/mr-ui у GitHub Packages) — бібліотека інтерфейсу платформи «Облік персоналу»: компоненти, тема, доступність (WCAG 2.2 AA), галерея",
  "packageManager": "npm@10.9.9",
  "scripts": {
    "start": "ng serve gallery",
    "build": "ng build ui",
    "build:gallery": "ng build gallery",
    "test": "ng test gallery --watch=false",
    "a11y": "ng build gallery && node scripts/a11y.mjs",
    "format": "prettier --write \"projects/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,css}\" \"scripts/**/*.mjs\"",
    "pack": "ng build ui && npm pack ./dist/ui --pack-destination dist"
  },
  "dependencies": {
    "@angular/cdk": "~22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.12.0",
    "axe-core": "^4.10.0",
    "daisyui": "^5.8.2",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
